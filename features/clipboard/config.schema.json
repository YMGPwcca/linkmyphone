{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkmyphone.local/schema/features/clipboard/1.0",
  "title": "LinkMyPhone clipboard module configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "poll_interval_ms": {
      "description": "MIME observation interval for rich backends; fallback interval for text-only providers.",
      "type": "integer",
      "minimum": 50,
      "maximum": 60000,
      "default": 500
    },
    "request_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000,
      "default": 10000
    },
    "publish_initial": {
      "type": "boolean",
      "default": false
    }
  }
}
