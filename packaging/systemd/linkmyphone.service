[Unit]
Description=LinkMyPhone user runtime
Documentation=https://github.com/YMGPwcca/linkmyphone
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90s
ExecStart=%h/.local/bin/linkmyphone run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=mixed
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkmyphone

[Install]
WantedBy=graphical-session.target
