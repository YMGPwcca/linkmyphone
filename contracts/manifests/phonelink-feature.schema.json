{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonelink-linux.local/schema/manifests/feature-1.0.json",
  "title": "Phone Link Linux built-in feature manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "runtime",
    "capabilities",
    "dependencies",
    "permissions",
    "configuration_schema",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "const": "builtin"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version"],
      "properties": {
        "api_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["potential"],
      "properties": {
        "potential": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contract_version"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
              },
              "contract_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "$ref": "#/$defs/dependencies"
        },
        "optional": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          }
        }
      }
    },
    "configuration_schema": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "description", "diagnostic_label"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "diagnostic_label": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "minimum_version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          },
          "minimum_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          }
        }
      }
    }
  }
}
